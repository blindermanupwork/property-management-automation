# Example environment file - Copy to .env and fill with your actual values
# NEVER commit the actual .env file with real credentials
# Last updated: 2025-08-11

# ============================================
# ROOT ENVIRONMENT (.env)
# ============================================

# Common Airtable Table Names
PROPERTIES_TABLE_NAME=Properties
ICS_FEEDS_TABLE_NAME=ICS Feeds
AUTOMATION_TABLE_NAME=Automation Control

# Common Airtable Field Names
PROPERTIES_NAME_FIELD=Property Name
PROPERTY_LINK_FIELD=Property ID
AUTOMATION_NAME_FIELD=Name
AUTOMATION_ACTIVE_FIELD=Active
AUTOMATION_LAST_RAN_FIELD=Last Ran
AUTOMATION_SYNC_DETAILS_FIELD=Sync Details

# Date Filtering Configuration
IGNORE_EVENTS_ENDING_BEFORE_TODAY=true
IGNORE_BLOCKS_MONTHS_AWAY=6
IGNORE_EVENTS_ENDING_MONTHS_AWAY=6

# Domain Configuration (for migration)
API_DOMAIN=your-domain.com

# HousecallPro Webhook Configuration
HCP_WEBHOOK_SECRET=your-hcp-webhook-secret
HCP_WEBHOOK_URL=https://your-domain.com/webhooks/hcp
HCP_API_BASE=https://pro.housecallpro.com
HCP_DEFAULT_EMPLOYEE_ID=your-default-employee-id

# OpenAI Configuration  
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Evolve Portal Credentials
EVOLVE_USERNAME=your-evolve-username
EVOLVE_PASSWORD=your-evolve-password

# Gmail Configuration (relative paths) - DEPRECATED
GMAIL_CREDS_PATH=scripts/gmail/credentials.json
GMAIL_TOKEN_PATH=scripts/gmail/token.pickle

# Server Configuration
PORT=5000
BEHIND_PROXY=true
REQUIRE_HTTPS=true

# Security Configuration
MAX_REQUESTS_PER_MINUTE=60
MAX_PAYLOAD_SIZE=1048576
SIGNATURE_TOLERANCE=300
SERVATIV_WEBHOOK_SECRET=your-internal-webhook-secret

# ============================================
# DEVELOPMENT ENVIRONMENT (config/environments/dev/.env)
# ============================================

# Development Airtable Configuration
DEV_AIRTABLE_API_KEY=pat-your-dev-airtable-key
DEV_AIRTABLE_BASE_ID=app67yWFv0hKdl6jM
DEV_AIRTABLE_TABLE_ID=tbl-your-table-id

# Development HousecallPro Configuration
DEV_HCP_TOKEN=your-dev-hcp-token
DEV_HCP_BASE_URL=https://pro.housecallpro.com
DEV_HCP_EMPLOYEE_ID=emp-your-employee-id
DEV_HCP_RETURN_LAUNDRY_JOB_TYPE=jt-laundry-id
DEV_HCP_INSPECTION_JOB_TYPE=jt-inspection-id
DEV_HCP_TURNOVER_JOB_TYPE=jt-turnover-id

# Alternative naming (both work)
DEV_HCP_JOB_TYPE_TURNOVER=jt-turnover-id
DEV_HCP_JOB_TYPE_INSPECTION=jt-inspection-id
DEV_HCP_JOB_TYPE_RETURN_LAUNDRY=jt-laundry-id

# Logging
LOG_LEVEL=debug

# ============================================
# PRODUCTION ENVIRONMENT (config/environments/prod/.env)
# ============================================

# Production Airtable Configuration
PROD_AIRTABLE_API_KEY=pat-your-prod-airtable-key
PROD_AIRTABLE_BASE_ID=appZzebEIqCU5R9ER
PROD_AIRTABLE_TABLE_ID=tbl-your-table-id

# Production HousecallPro Configuration
PROD_HCP_TOKEN=your-prod-hcp-token
PROD_HCP_BASE_URL=https://pro.housecallpro.com
PROD_HCP_EMPLOYEE_ID=emp-your-employee-id
PROD_HCP_RETURN_LAUNDRY_JOB_TYPE=jt-laundry-id
PROD_HCP_INSPECTION_JOB_TYPE=jt-inspection-id
PROD_HCP_TURNOVER_JOB_TYPE=jt-turnover-id

# Alternative naming (both work)
PROD_HCP_JOB_TYPE_TURNOVER=jt-turnover-id
PROD_HCP_JOB_TYPE_INSPECTION=jt-inspection-id
PROD_HCP_JOB_TYPE_RETURN_LAUNDRY=jt-laundry-id

# Logging
LOG_LEVEL=info

# ============================================
# OTHER SERVICE CONFIGURATIONS
# ============================================

# AirScripts API (src/automation/scripts/airscripts-api/.env)
NODE_ENV=production
API_KEY=airscripts-secure-key-2025
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# Airtable MCP Server (tools/airtable-mcp-server/.env)
AIRTABLE_API_KEY=pat-your-airtable-key

# Trello MCP Server (tools/trello-mcp-server/.env)
TRELLO_API_KEY=your-trello-api-key
TRELLO_API_SECRET=your-trello-api-secret
TRELLO_TOKEN=your-trello-token
TRELLO_BOARD_ID=your-board-id

# ============================================
# NOTES
# ============================================
# 1. Main .env file contains shared configuration
# 2. Environment-specific files in config/environments/{dev|prod}/
# 3. Service-specific .env files in their respective directories
# 4. Use PROD_* prefix for production, DEV_* for development
# 5. API_DOMAIN should match your server's domain for migration
# 6. After migration, rotate all API keys and secrets
# 7. Set file permissions to 600 for all .env files